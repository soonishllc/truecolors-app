{
  "expo": {
    "name": "Truecolors",
    "slug": "truecolors",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "truecolors",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "global.truecolors.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Take a photo of your sketch so the AI can draw it as a design.",
        "NSPhotoLibraryUsageDescription": "Choose a photo of your sketch, or of your till report, to upload.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "global.truecolors.app",
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#111111",
          "imageWidth": 220
        }
      ],
      "expo-sharing",
      "expo-image",
      [
        "expo-notifications",
        {
          "color": "#e8762a"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#111111"
  }
}
