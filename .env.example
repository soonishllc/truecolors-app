# Copy to .env.local. Everything has a working default for local development.
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_EMAILS=kevin@probablyfine.ae
DEV_SHOW_LOGIN_LINKS=true

# Blank = embedded Postgres in .pglite/. Set for production.
DATABASE_URL=
STORAGE_DIR=./storage

# mock draws placeholder art; openai needs a key.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

SHOPIFY_STORE_DOMAIN=cjfxb1-ex.myshopify.com
SHOPIFY_STOREFRONT_URL=https://truecolors.global/en-us
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-10
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_US_PUBLICATION_ID=
SHOPIFY_PLUS=false

# Blank until the lawyers sign off the designer agreement; campaigns can't be approved while blank.
DESIGNER_AGREEMENT_VERSION=

CRON_SECRET=change-me
