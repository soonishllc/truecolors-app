{%- comment -%}
  Truecolors Retail Partners: B2B landing page for consignment displays in hotel boutiques,
  airports and attractions. Three stands (Sunbox, Prism, Tower), how consignment works, and an
  enquiry form that posts to the store's contact form, so enquiries arrive in the same inbox as Wholesale.
  Install: copy to sections/, and the files in assets/ to the theme's assets/. Create page "Retail partners" (handle retail-partners) with a template
  that holds only this section. Styles are scoped to .tcp so they can't leak into the theme.
{%- endcomment -%}

<style>
  .tcp { --bg: #faf9f8; --tint: #f3f1f0; --surface: #fff; --ink: #2a2926; --muted: #6f6b64; --line: #e6e2dc;
    --dark: #232220; --dark-ink: #faf9f8; --gold: #cdaa3d; --gold-text: #9a7b20;
    --sun: linear-gradient(90deg, #c43fd3, #e5603f, #f29a0c, #f2e600);
    --display: "Space Grotesk", sans-serif; --serif: "Instrument Serif", "Times New Roman", serif;
    --mono: "JetBrains Mono", ui-monospace, Menlo, monospace; --body: Assistant, sans-serif;
    font-family: var(--body); color: var(--ink); background: var(--bg); font-size: 17px; line-height: 1.55; overflow-x: clip; }
  .tcp *, .tcp *::before, .tcp *::after { box-sizing: border-box; }
  .tcp-wrap { max-width: 1180px; margin: 0 auto; padding: 0 24px; }
  .tcp-band { padding: 96px 0; }
  .tcp-band--tint { background: var(--tint); }
  .tcp-band--dark { background: var(--dark); color: var(--dark-ink); }
  .tcp-label { font-family: var(--mono); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--gold-text); margin: 0 0 18px; display: flex; align-items: center; gap: 10px; }
  .tcp-label::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
  .tcp-band--dark .tcp-label, .tcp-hero .tcp-label { color: var(--gold); }
  .tcp h1, .tcp h2, .tcp h3 { font-family: var(--display); font-weight: 500; letter-spacing: -.035em; margin: 0; }
  .tcp h1 { font-size: clamp(42px, 6.4vw, 78px); line-height: 1; }
  .tcp h2 { font-size: clamp(32px, 4.2vw, 52px); line-height: 1.04; max-width: 18ch; }
  .tcp h3 { font-size: 24px; letter-spacing: -.02em; }
  .tcp em { font-family: var(--serif); font-style: italic; font-weight: 400; letter-spacing: -.01em; }
  .tcp p { margin: 0; }
  .tcp-lede { font-size: 19px; color: var(--muted); max-width: 58ch; margin-top: 20px !important; }
  .tcp-band--dark .tcp-lede { color: #c9c5be; }
  .tcp-head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px 64px; align-items: end; }
  .tcp-head h2 { max-width: 16ch; }
  .tcp-head .tcp-lede { margin: 0 !important; justify-self: end; }
  .tcp-btn { display: inline-flex; align-items: center; gap: 10px; border-radius: 999px; padding: 15px 28px; font-family: var(--display); font-size: 15px; font-weight: 500; text-decoration: none; border: 1px solid var(--ink); background: var(--ink); color: var(--bg); cursor: pointer; transition: transform .15s ease, box-shadow .25s ease; }
  .tcp-btn:hover { transform: translateY(-1px); box-shadow: 0 8px 24px -8px rgba(229, 96, 63, .6); }
  .tcp-btn--light { background: var(--dark-ink); color: var(--dark); border-color: var(--dark-ink); }
  .tcp-btn--ghost { background: transparent; color: inherit; border-color: rgba(250, 249, 248, .35); }
  .tcp-btn--ghost:hover { border-color: var(--dark-ink); box-shadow: none; }

  /* Hero: dark band, photo fading in from the right, like the store's. */
  /* Hero: the same sunset gradient, glows, stripes and dot texture as the store's Wholesale page. */
  .tcp-hero { position: relative; color: var(--dark-ink); padding: 112px 0 96px; overflow: hidden; background:
    radial-gradient(80% 70% at 20% 30%, oklab(0.75 -0.002 0.13 / 0.55) 0%, transparent 60%),
    radial-gradient(70% 60% at 85% 80%, oklch(0.55 0.18 310 / 0.6) 0%, transparent 60%),
    radial-gradient(60% 50% at 50% 100%, oklch(0.72 0.16 140 / 0.5) 0%, transparent 60%),
    linear-gradient(oklch(0.28 0.08 40) 0%, oklch(0.38 0.13 35) 30%, oklch(0.55 0.17 45) 60%, oklch(0.72 0.17 55) 100%),
    url({{ 'dot-bg.gif' | asset_url }}) center / cover; }
  .tcp-hero::before { content: ""; position: absolute; inset: 0; background: repeating-linear-gradient(135deg, rgba(255, 255, 255, .043) 0 2px, transparent 2px 16px); pointer-events: none; }
  .tcp-hero .tcp-wrap { position: relative; }
  .tcp-hero .tcp-lede { color: rgba(250, 249, 248, .86); }
  .tcp-hero .tcp-facts div { background: rgba(35, 34, 32, .45); }
  .tcp-hero .tcp-facts span { color: rgba(250, 249, 248, .7); }

  /* The walk-out loop: the same doorway in shade and in sun, framed portrait. */
  .tcp-film { position: relative; margin: 0; justify-self: end; width: min(100%, 360px, calc(78vh * 9 / 16)); aspect-ratio: 9 / 16; border-radius: 10px; overflow: hidden; background: #111; box-shadow: 0 30px 60px -30px rgba(0, 0, 0, .55); }
  .tcp-film video, .tcp-film img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tcp-film img { position: absolute; inset: 0; transform-origin: 50% 15%; animation: tcp-push 18s ease-in-out infinite alternate; }
  .tcp-film-sun { clip-path: inset(100% 0 0 0); animation: tcp-push 18s ease-in-out infinite alternate, tcp-sunrise 9s cubic-bezier(.45, 0, .25, 1) infinite; }
  @keyframes tcp-push { from { transform: scale(1); } to { transform: scale(1.05); } }
  /* Shade, then the sun climbs from the threshold up the shirt, holds, and fades back to shade. */
  @keyframes tcp-sunrise { 0%, 12% { clip-path: inset(100% 0 0 0); opacity: 1; } 45%, 80% { clip-path: inset(0 0 0 0); opacity: 1; } 95% { clip-path: inset(0 0 0 0); opacity: 0; } 100% { clip-path: inset(100% 0 0 0); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .tcp-film img { animation: none; } .tcp-film-sun { clip-path: none; } }
  .tcp-film figcaption { position: absolute; left: 12px; bottom: 12px; font-family: var(--mono); font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; padding: 5px 9px; border-radius: 2px; background: rgba(35, 34, 32, .7); color: #fff; }
  .tcp-where { display: grid; grid-template-columns: 1.2fr .8fr; gap: 56px; align-items: center; }
  .tcp-hero h1 { max-width: 13ch; }
  .tcp-hero h1 em { color: rgba(250, 249, 248, .82); display: block; }
  .tcp-hero .tcp-lede { color: #c9c5be; max-width: 46ch; }
  .tcp-hero-ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }
  .tcp-hero-grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(260px, .7fr); gap: 56px; align-items: end; }
  .tcp-facts { display: grid; grid-template-columns: 1fr; gap: 1px; background: rgba(250, 249, 248, .14); border: 1px solid rgba(250, 249, 248, .14); border-radius: 6px; overflow: hidden; }
  .tcp-facts div { background: rgba(35, 34, 32, .82); padding: 18px 20px; backdrop-filter: blur(6px); }
  .tcp-facts b { display: block; font-family: var(--display); font-size: 28px; font-weight: 500; letter-spacing: -.03em; }
  .tcp-facts span { font-family: var(--mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: #a49f97; }

  /* The indoor problem: shade and sun photos of one tee; the sunlight sweeps in from the corner, like the studio's header. */
  .tcp-split { display: grid; grid-template-columns: 1.1fr .9fr; gap: 64px; align-items: center; }
  .tcp-reveal { position: relative; aspect-ratio: 4 / 5; width: min(100%, 440px); justify-self: end; border-radius: 8px; overflow: hidden; background: #e9e5df; }
  .tcp-reveal img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
  .tcp-reveal-sun { clip-path: circle(0% at 92% 4%); transition: clip-path 1.6s cubic-bezier(.4, 0, .2, 1); }
  .tcp-reveal.on .tcp-reveal-sun { clip-path: circle(160% at 92% 4%); }
  .tcp-reveal-label { position: absolute; top: 14px; font-family: var(--mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; padding: 4px 8px; border-radius: 2px; background: rgba(35, 34, 32, .75); color: #fff; transition: opacity .6s ease; }
  .tcp-reveal-label.shade { left: 14px; }
  .tcp-reveal-label.sun { left: 14px; opacity: 0; }
  .tcp-reveal.on .tcp-reveal-label.shade { opacity: 0; }
  .tcp-reveal.on .tcp-reveal-label.sun { opacity: 1; }
  .tcp-reveal-btn { position: absolute; left: 50%; bottom: 20px; transform: translateX(-50%); white-space: nowrap; border-radius: 999px; padding: 11px 20px; font: 500 14px var(--display); cursor: pointer; color: var(--dark-ink); background: rgba(35, 34, 32, .55); border: 1px solid rgba(250, 249, 248, .4); backdrop-filter: blur(6px); transition: background .25s ease, color .25s ease; }
  .tcp-reveal-btn:hover { background: var(--dark-ink); color: var(--dark); }
  .tcp-points { list-style: none; padding: 0; margin: 32px 0 0; display: grid; gap: 18px; }
  .tcp-points li { display: grid; grid-template-columns: 28px 1fr; gap: 10px; }
  .tcp-points li::before { content: "→"; font-family: var(--mono); color: var(--gold-text); }

  /* 3D viewer: drag to turn, press for sun. The canvas sits on the same grey sweep as the renders. */
  .tcp-3d { display: grid; grid-template-columns: 1.55fr 1fr; gap: 0; margin-top: 48px; border-radius: 8px; overflow: hidden; border: 1px solid var(--line); background: var(--surface); }
  .tcp-3d-stage { position: relative; height: 620px; background: radial-gradient(ellipse at 50% 40%, #f1efec 0%, #dedbd7 70%, #d2cec9 100%); cursor: grab; }
  .tcp-3d-stage canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; }
  .tcp-3d-loading { position: absolute; inset: 0; display: grid; place-items: center; margin: 0; font-family: var(--mono); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); transition: opacity .4s ease; pointer-events: none; }
  .tcp-3d.ready .tcp-3d-loading { opacity: 0; }
  .tcp-3d-side { padding: 36px; display: flex; flex-direction: column; gap: 16px; justify-content: center; }
  .tcp-3d-side p { color: var(--muted); }
  .tcp-3d-tabs { display: flex; flex-wrap: wrap; gap: 8px; }
  .tcp-3d-tabs button { border: 1px solid var(--line); background: var(--surface); color: var(--ink); border-radius: 999px; padding: 9px 16px; font: 500 14px var(--display); cursor: pointer; }
  .tcp-3d-tabs button[aria-pressed="true"] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .tcp-3d-hint { font-family: var(--mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }

  /* Display cards */
  /* Tower first as a wide feature card; Sunbox and Prism side by side below. Every card is render left, details right. */
  .tcp-units { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 56px; }
  .tcp-unit.tcp-unit--wide { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 460px) minmax(0, 1fr); }
  .tcp-unit:not(.tcp-unit--wide) { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); }
  .tcp-unit--wide .tcp-unit-body { padding: 40px 48px; gap: 18px; justify-content: center; }
  .tcp-unit--wide .tcp-unit-foot { margin-top: 12px; grid-template-columns: minmax(0, 1fr) 240px; }
  .tcp-unit--wide h3 { font-size: 32px; }
  .tcp-unit-foot { margin-top: auto; display: grid; grid-template-columns: minmax(0, 1fr) 210px; gap: 28px; align-items: end; padding-top: 20px; border-top: 1px solid var(--line); }
  .tcp-unit-foot .tcp-specs { margin: 0; padding: 0; border: 0; }
  .tcp-detail { position: relative; margin: 0; border-radius: 6px; overflow: hidden; box-shadow: 0 18px 34px -22px rgba(42, 41, 38, .6); }
  .tcp-detail img { width: 100%; height: auto; display: block; }
  .tcp-detail figcaption { position: absolute; left: 8px; bottom: 8px; font-family: var(--mono); font-size: 10px; letter-spacing: .1em; text-transform: uppercase; padding: 4px 8px; border-radius: 2px; background: rgba(35, 34, 32, .78); color: #fff; }
  .tcp-unit { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; overflow: hidden; display: flex; flex-direction: column; transition: transform .3s ease, box-shadow .3s ease; }
  .tcp-unit:hover { transform: translateY(-4px); box-shadow: 0 24px 48px -28px rgba(42, 41, 38, .45); }
  .tcp-unit-art { background: linear-gradient(180deg, #efece8, #e4e0da); height: 340px; display: grid; place-items: end center; padding-top: 24px; position: relative; }
  /* Studio renders with dimension callouts, 2:3. */
  .tcp-unit-art { height: auto; padding: 0; background: #dddbd8; display: block; }
  .tcp-photo { display: block; width: 100%; height: auto; aspect-ratio: 2 / 3; object-fit: cover; transition: transform .6s ease; }
  .tcp-unit:hover .tcp-photo { transform: scale(1.03); }
  .tcp-unit-art { overflow: hidden; }
  /* Press-for-sun clip: fades in over the render on hover (or when it scrolls into view on touch screens). */
  .tcp-clip { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; background: #dcdad7; opacity: 0; transition: opacity .45s ease; pointer-events: none; }
  .tcp-unit.playing .tcp-clip { opacity: 1; }
  .tcp-clip-hint { position: absolute; right: 14px; bottom: 14px; z-index: 2; border: 0; border-radius: 999px; padding: 8px 14px; background: rgba(35, 34, 32, .82); color: #fff; font: 500 13px var(--display); cursor: pointer; transition: opacity .3s ease; }
  .tcp-unit.playing .tcp-clip-hint { opacity: 0; }
  .tcp-tag { position: absolute; top: 16px; left: 16px; font-family: var(--mono); font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; background: var(--dark); color: var(--dark-ink); padding: 5px 9px; border-radius: 2px; }
  .tcp-unit-body { padding: 24px; display: flex; flex-direction: column; gap: 14px; flex: 1; }
  .tcp-unit-body > p { color: var(--muted); font-size: 16px; }
  .tcp-specs { margin: auto 0 0; padding: 16px 0 0; border-top: 1px solid var(--line); display: grid; grid-template-columns: auto 1fr; gap: 8px 16px; font-size: 14px; }
  .tcp-specs dt { font-family: var(--mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); padding-top: 2px; }
  .tcp-specs dd { margin: 0; }
  .tcp-unit-body > .tcp-best { font-family: var(--mono); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--gold-text); }

  /* Who brings what */
  .tcp-terms { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; margin: 48px 0 0; background: rgba(250, 249, 248, .16); border: 1px solid rgba(250, 249, 248, .16); border-radius: 8px; overflow: hidden; }
  .tcp-terms div { background: var(--dark); padding: 22px 24px; }
  .tcp-terms dt { font-family: var(--mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--gold); }
  .tcp-terms dd { margin: 8px 0 4px; font-family: var(--display); font-size: 30px; font-weight: 500; letter-spacing: -.03em; }
  .tcp-terms p { color: #a49f97; font-size: 14px; }
  .tcp-deal { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 48px; }
  .tcp-deal > div { border: 1px solid rgba(250, 249, 248, .16); border-radius: 8px; padding: 32px; }
  .tcp-deal > div:first-child { background: rgba(250, 249, 248, .04); position: relative; overflow: hidden; }
  .tcp-deal > div:first-child::before { content: ""; position: absolute; inset: 0 0 auto; height: 3px; background: var(--sun); }
  .tcp-deal ul { list-style: none; padding: 0; margin: 20px 0 0; display: grid; gap: 12px; }
  .tcp-deal li { display: grid; grid-template-columns: 22px 1fr; color: #d8d4cd; }
  .tcp-deal li::before { content: "✓"; color: var(--gold); }
  .tcp-steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; margin-top: 64px; counter-reset: step; }
  .tcp-steps div { counter-increment: step; border-top: 1px solid rgba(250, 249, 248, .2); padding-top: 18px; }
  .tcp-steps div::before { content: "0" counter(step); display: block; font-family: var(--mono); font-size: 12px; color: var(--gold); margin-bottom: 14px; }
  .tcp-steps h3 { font-size: 20px; margin-bottom: 8px; }
  .tcp-steps p { color: #a49f97; font-size: 15px; }

  /* Venues */
  .tcp-venues { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 36px; }
  .tcp-venues span { border: 1px solid var(--line); background: var(--surface); border-radius: 999px; padding: 10px 18px; font-size: 15px; }

  /* FAQ */
  .tcp-faq { margin-top: 40px; border-top: 1px solid var(--line); }
  .tcp-faq details { border-bottom: 1px solid var(--line); }
  .tcp-faq summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: 24px; padding: 22px 0; font-family: var(--display); font-size: 20px; letter-spacing: -.02em; }
  .tcp-faq summary::-webkit-details-marker { display: none; }
  .tcp-faq summary::after { content: "+"; font-family: var(--mono); color: var(--gold-text); transition: transform .2s ease; }
  .tcp-faq details[open] summary::after { transform: rotate(45deg); }
  .tcp-faq details p { padding: 0 0 22px; color: var(--muted); max-width: 70ch; }

  /* Form */
  .tcp-form-grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: 64px; }
  .tcp-form { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .tcp-form label { display: grid; gap: 8px; font-family: var(--mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
  .tcp-form .full { grid-column: 1 / -1; }
  .tcp-form input, .tcp-form select, .tcp-form textarea { font: 400 16px var(--body); padding: 13px 14px; border: 1px solid var(--line); border-radius: 4px; background: var(--surface); color: var(--ink); width: 100%; }
  .tcp-form textarea { min-height: 110px; resize: vertical; }
  .tcp-form input:focus, .tcp-form select:focus, .tcp-form textarea:focus { outline: 2px solid var(--gold); outline-offset: 0; border-color: transparent; }
  .tcp-choice { display: flex; flex-wrap: wrap; gap: 8px; }
  .tcp-choice label { display: inline-flex; flex-direction: row; align-items: center; gap: 8px; border: 1px solid var(--line); background: var(--surface); border-radius: 999px; padding: 9px 14px; font: 400 15px var(--body); letter-spacing: 0; text-transform: none; color: var(--ink); cursor: pointer; }
  .tcp-choice input { width: auto; accent-color: var(--ink); }
  .tcp-note { padding: 14px 16px; border-radius: 4px; background: #fbf3dc; color: #5c4500; }
  .tcp-note--bad { background: #fbe4e1; color: #8a231c; }

  @media (max-width: 960px) {
    .tcp-band { padding: 72px 0; }
    .tcp-split, .tcp-form-grid, .tcp-deal { grid-template-columns: 1fr; gap: 40px; }
    .tcp-hero-grid { grid-template-columns: 1fr; gap: 48px; }
    .tcp-hero .tcp-facts { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .tcp-head { grid-template-columns: 1fr; }
    .tcp-head .tcp-lede { justify-self: start; }
    .tcp-units { grid-template-columns: 1fr; }
    .tcp-unit.tcp-unit--wide, .tcp-unit:not(.tcp-unit--wide) { grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); }
    .tcp-unit--wide .tcp-unit-body { padding: 28px; }
    .tcp-unit-foot, .tcp-unit--wide .tcp-unit-foot { grid-template-columns: 1fr; }
    .tcp-detail { max-width: 240px; }
    .tcp-3d { grid-template-columns: 1fr; }
    .tcp-3d-stage { height: 480px; }
    .tcp-3d-side { padding: 24px; }
    .tcp-steps, .tcp-terms { grid-template-columns: 1fr 1fr; }
    .tcp-where { grid-template-columns: 1fr; gap: 40px; }
    .tcp-film, .tcp-reveal { justify-self: center; }
    .tcp-film { width: min(100%, 320px); }
  }
  @media (max-width: 600px) {
    .tcp-wrap { padding: 0 16px; }
    .tcp-hero { padding: 88px 0 64px; }
    .tcp-hero .tcp-facts { grid-template-columns: 1fr; }
    .tcp-unit.tcp-unit--wide, .tcp-unit:not(.tcp-unit--wide) { grid-template-columns: 1fr; }
    .tcp-unit-body, .tcp-unit--wide .tcp-unit-body { padding: 22px; }
    .tcp-unit-foot, .tcp-unit--wide .tcp-unit-foot { grid-template-columns: minmax(0, 1fr) 128px; gap: 16px; }
    .tcp-steps, .tcp-form { grid-template-columns: 1fr; }
    .tcp-deal > div { padding: 24px; }
  }
  @media (prefers-reduced-motion: reduce) { .tcp *, .tcp *::before { transition: none !important; } }
</style>

<div class="tcp">

  <section class="tcp-hero">
    <div class="tcp-wrap tcp-hero-grid">
      <div>
      <p class="tcp-label">§ 01 / Retail partners · Truecolors</p>
      <h1>Bring the sun indoors. <em>A display that sells itself.</em></h1>
      <p class="tcp-lede">Colour-changing tees for hotel boutiques, airport shops and attractions. We supply the display, the stock and the demo. You give us a few square feet and keep a share of every shirt sold.</p>
      <div class="tcp-hero-ctas">
        <a class="tcp-btn tcp-btn--light" href="#tcp-enquire">Request a display →</a>
        <a class="tcp-btn tcp-btn--ghost" href="#tcp-displays">See the three displays</a>
      </div>
      </div>
      <div class="tcp-facts">
        <div><b>$0</b><span>Upfront cost</span></div>
        <div><b>Consignment</b><span>Settle only what sells</span></div>
        <div><b>Every 15 days</b><span>Settlement</span></div>
      </div>
    </div>
  </section>

  <section class="tcp-band">
    <div class="tcp-wrap tcp-split">
      <div>
        <p class="tcp-label">§ 02 / Why a display</p>
        <h2>Indoors, our tees look calm. <em>That's why we bring the sun with us.</em></h2>
        <p class="tcp-lede">Truecolors prints show grey line art in the shade and burst into full colour in direct sunlight. Under shop lighting nobody sees the trick, so every one of our displays carries its own sun: a UV light behind glass that guests switch on with a button.</p>
        <ul class="tcp-points">
          <li><span><strong>A souvenir guests play with.</strong> Pressing the button turns browsing into a moment people film and share.</span></li>
          <li><span><strong>Designs made for your location.</strong> Your city, your resort, your landmark, drawn by our team and printed for your shelf.</span></li>
          <li><span><strong>Easy to sell.</strong> The display does the explaining, so your staff only have to ring it up.</span></li>
        </ul>
      </div>
      <div class="tcp-reveal" id="tcp-reveal">
        <img src="{{ 'tc-person-shade.jpg' | asset_url }}" alt="A guest in the shade wearing the Target Destroyed tee: the print shows only grey line art" width="880" height="1100" loading="lazy">
        <img class="tcp-reveal-sun" src="{{ 'tc-person-sun.jpg' | asset_url }}" alt="" aria-hidden="true" width="880" height="1100" loading="lazy">
        <span class="tcp-reveal-label shade">Shade</span><span class="tcp-reveal-label sun">Sun</span>
        <button type="button" class="tcp-reveal-btn" aria-pressed="false">☀ Step into the sun</button>
      </div>
    </div>
  </section>

  <section class="tcp-band tcp-band--tint" id="tcp-displays">
    <div class="tcp-wrap">
      <div class="tcp-head">
        <div>
          <p class="tcp-label">§ 03 / The displays</p>
          <h2>Three displays, <em>sized to the space you have.</em></h2>
        </div>
        <p class="tcp-lede">Every display has a working sun. Choose the one that fits your floor plan, or mix them across several outlets.</p>
      </div>

      {%- assign tcp_screen = section.settings.screen_video.sources | where: 'mime_type', 'video/mp4' | first -%}
      <div class="tcp-3d" data-tcp-viewer data-start="prism" data-screen="{{ tcp_screen.url }}"
        data-logo="{{ 'tc-logo.png' | asset_url }}"
        data-designs='{
          "habibi": { "sun": "{{ 'tc-flat-habibi-sun.jpg' | asset_url }}", "shade": "{{ 'tc-flat-habibi-shade.jpg' | asset_url }}" },
          "target": { "sun": "{{ 'tc-flat-target-sun.jpg' | asset_url }}", "shade": "{{ 'tc-flat-target-shade.jpg' | asset_url }}" },
          "newyork": { "sun": "{{ 'tc-flat-newyork-sun.jpg' | asset_url }}", "shade": "{{ 'tc-flat-newyork-shade.jpg' | asset_url }}", "tee": "#1d1d1f" },
          "beach": { "sun": "{{ 'tc-flat-beach-sun.jpg' | asset_url }}", "shade": "{{ 'tc-flat-beach-shade.jpg' | asset_url }}" },
          "dune": { "sun": "{{ 'tc-flat-dune-sun.jpg' | asset_url }}", "shade": "{{ 'tc-flat-dune-shade.jpg' | asset_url }}" },
          "emirati": { "sun": "{{ 'tc-flat-emirati-sun.jpg' | asset_url }}", "shade": "{{ 'tc-flat-emirati-shade.jpg' | asset_url }}" },
          "gallery": { "sun": "{{ 'tc-tower-gallery-sun.jpg' | asset_url }}", "shade": "{{ 'tc-tower-gallery-shade.jpg' | asset_url }}", "screen": false }
        }'>
        <div class="tcp-3d-stage">
          <canvas aria-label="3D model of the selected display. Drag to turn it; press its orange button to switch on the sun."></canvas>
          <p class="tcp-3d-loading">Loading 3D view…</p>
        </div>
        <div class="tcp-3d-side">
          <p class="tcp-label" style="margin:0">Turn it around</p>
          <h3>See every side, <em>then press for sun.</em></h3>
          <p>Drag to turn the display. Click its orange button, or the one below, and watch the UV light colour up the shirt, just as a guest would.</p>
          <div class="tcp-3d-tabs" role="group" aria-label="Choose a display">
            <button type="button" data-model="sunbox" aria-pressed="false">Sunbox</button>
            <button type="button" data-model="prism" aria-pressed="true">Prism</button>
            <button type="button" data-model="tower" aria-pressed="false">Tower</button>
          </div>
          <div><button type="button" class="tcp-btn" data-sun>☀ Press for sun</button></div>
          <p class="tcp-3d-hint">Built to the spec dimensions</p>
        </div>
      </div>
      <script type="module" src="{{ 'tc-display-viewer.js' | asset_url }}"></script>

      <div class="tcp-units">

        <article class="tcp-unit tcp-unit--wide">
          <div class="tcp-unit-art">
            <span class="tcp-tag">Floor · stock + gallery</span>
            {%- if section.settings.tower_image != blank -%}
              {{ section.settings.tower_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 700, 900', sizes: '(max-width: 960px) 100vw, 460px', class: 'tcp-photo', alt: 'Tower display with dimensions: stock by size on the front and a UV-lit gallery of ten designs on the side' }}
            {%- else -%}
              <img class="tcp-photo" src="{{ 'tc-display-tower.jpg' | asset_url }}" alt="Tower display with dimensions: stock by size on the front and a UV-lit gallery of ten designs on the side" width="800" height="1200" loading="lazy">
            {%- endif -%}
            {%- assign tcp_clip = section.settings.tower_clip.sources | where: 'mime_type', 'video/mp4' | first -%}
            {%- if tcp_clip -%}<video class="tcp-clip" muted playsinline preload="none" src="{{ tcp_clip.url }}" aria-hidden="true"></video><button type="button" class="tcp-clip-hint">☀ Press for sun</button>{%- endif -%}
          </div>
          <div class="tcp-unit-body">
            <h3>Tower</h3>
            <p>A full shop-in-shop. Each side carries a gallery of ten designs behind glass, twenty in all, that light up at the press of a button. Stock sits in through-cubbies by size, open at the front and the back: as an island, guests shop it from both sides; against a wall, it still works from the front.</p>
            <p class="tcp-best">Best for: resort boutiques, gift shops, high-traffic outlets</p>
            <div class="tcp-unit-foot">
              <dl class="tcp-specs">
                <dt>Size</dt><dd>102 × 56 cm, 183 cm tall</dd>
                <dt>Floor</dt><dd>0.57 m², island or against a wall</dd>
                <dt>Shows</dt><dd>20 designs, lit on demand</dd>
                <dt>Stock</dt><dd>About 340 shirts, 28 through-cubbies by size</dd>
                <dt>Power</dt><dd>1 standard socket</dd>
              </dl>
              <figure class="tcp-detail">
                <img src="{{ 'tc-tower-gallery-detail.jpg' | asset_url }}" alt="Close-up of the Tower's side gallery: folded tees face-out behind glass, lit violet, each print in full colour" width="640" height="651" loading="lazy">
                <figcaption>Side gallery · sun on</figcaption>
              </figure>
            </div>
          </div>
        </article>

        <article class="tcp-unit">
          <div class="tcp-unit-art">
            <span class="tcp-tag">Countertop</span>
            {%- if section.settings.sunbox_image != blank -%}
              {{ section.settings.sunbox_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 700, 900', sizes: '(max-width: 960px) 100vw, 380px', class: 'tcp-photo', alt: 'Sunbox countertop display with dimensions: one Truecolors tee in a UV-lit window, with a Press for sun button' }}
            {%- else -%}
              <img class="tcp-photo" src="{{ 'tc-display-sunbox.jpg' | asset_url }}" alt="Sunbox countertop display with dimensions: one Truecolors tee in a UV-lit window, with a Press for sun button" width="800" height="1200" loading="lazy">
            {%- endif -%}
            {%- assign tcp_clip = section.settings.sunbox_clip.sources | where: 'mime_type', 'video/mp4' | first -%}
            {%- if tcp_clip -%}<video class="tcp-clip" muted playsinline preload="none" src="{{ tcp_clip.url }}" aria-hidden="true"></video><button type="button" class="tcp-clip-hint">☀ Press for sun</button>{%- endif -%}
          </div>
          <div class="tcp-unit-body">
            <h3>Sunbox</h3>
            <p>One shirt in a lit window, right next to the till. Guests press the button and watch the print colour up while they pay.</p>
            <p class="tcp-best">Best for: front desks, small boutiques, checkouts</p>
            <dl class="tcp-specs">
              <dt>Size</dt><dd>42 × 30 cm, 60 cm tall</dd>
              <dt>Shows</dt><dd>1 demo shirt</dd>
              <dt>Stock</dt><dd>Behind the counter</dd>
              <dt>Power</dt><dd>Plug-in 12 V adapter</dd>
            </dl>
          </div>
        </article>

        <article class="tcp-unit">
          <div class="tcp-unit-art">
            <span class="tcp-tag">Floor · 3-sided</span>
            {%- if section.settings.prism_image != blank -%}
              {{ section.settings.prism_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 700, 900', sizes: '(max-width: 960px) 100vw, 380px', class: 'tcp-photo', alt: 'Prism three-sided display with dimensions: a screen on one face and a UV-lit demo tee on the next' }}
            {%- else -%}
              <img class="tcp-photo" src="{{ 'tc-display-prism.jpg' | asset_url }}" alt="Prism three-sided display with dimensions: a screen on one face and a UV-lit demo tee on the next" width="800" height="1200" loading="lazy">
            {%- endif -%}
            {%- assign tcp_clip = section.settings.prism_clip.sources | where: 'mime_type', 'video/mp4' | first -%}
            {%- if tcp_clip -%}<video class="tcp-clip" muted playsinline preload="none" src="{{ tcp_clip.url }}" aria-hidden="true"></video><button type="button" class="tcp-clip-hint">☀ Press for sun</button>{%- endif -%}
          </div>
          <div class="tcp-unit-body">
            <h3>Prism</h3>
            <p>A three-sided tower that draws people in from across the floor. One face plays a screen loop of the shade-to-sun change, and the other two hold shirts guests can light up themselves. It holds no stock: they buy at your counter.</p>
            <p class="tcp-best">Best for: airport gates, lobbies, corridors, tight corners</p>
            <dl class="tcp-specs">
              <dt>Size</dt><dd>60 cm per side, 185 cm tall</dd>
              <dt>Floor</dt><dd>0.15 m², about a quarter of a standard stand</dd>
              <dt>Shows</dt><dd>32″ screen + 2 demo shirts</dd>
              <dt>Stock</dt><dd>At your till or stockroom</dd>
              <dt>Power</dt><dd>1 standard socket</dd>
            </dl>
          </div>
        </article>

      </div>
    </div>
  </section>

  <section class="tcp-band tcp-band--dark">
    <div class="tcp-wrap">
      <div class="tcp-head">
        <div>
          <p class="tcp-label">§ 04 / How the partnership works</p>
          <h2>Consignment, <em>so the risk is ours.</em></h2>
        </div>
        <p class="tcp-lede">We install the display and deliver the shirts on consignment. They stay ours until they sell. Every shirt sells at one set retail price and you keep a share of each sale, settled every 15 days. Anything that doesn't sell, we take back.</p>
      </div>
      <dl class="tcp-terms">
        <div><dt>Upfront cost</dt><dd>None</dd><p>Display, stock and install are ours</p></div>
        <div><dt>Retail price</dt><dd>One price</dd><p>The same at every location, your share on each sale</p></div>
        <div><dt>Settlement</dt><dd>Every 15 days</dd><p>Weekly for busy locations</p></div>
        <div><dt>Payment</dt><dd>Our terminal</dd><p>Or your own till</p></div>
      </dl>
      <div class="tcp-deal">
        <div>
          <h3>Truecolors brings</h3>
          <ul>
            <li>The display, delivered, installed and maintained</li>
            <li>Opening stock in the sizes your guests buy</li>
            <li>Designs drawn for your location, or picks from our catalogue</li>
            <li>The demo: UV light, screen loop, shelf talkers</li>
            <li>Restocking and settlement every 15 days, weekly for busy locations</li>
            <li>Our own card terminal at the display, if you'd rather not handle payment</li>
          </ul>
        </div>
        <div>
          <h3>Your boutique brings</h3>
          <ul>
            <li>A visible spot, and a socket for floor units</li>
            <li>Selling at the set retail price</li>
            <li>If you use your own till: a record of units sold, and our share at each settlement</li>
          </ul>
        </div>
      </div>
      <div class="tcp-steps">
        <div><h3>Choose the spot</h3><p>We visit or review photos with you and pick the display that fits.</p></div>
        <div><h3>We install and stock</h3><p>Display, shirts and demo set up in a single visit, usually under an hour.</p></div>
        <div><h3>Guests press for sun</h3><p>They light up a shirt, pick a size and pay, on our terminal or at your till.</p></div>
        <div><h3>Settle and restock</h3><p>Every 15 days we count, pay you your share of what sold and refill what's running low.</p></div>
      </div>
    </div>
  </section>

  <section class="tcp-band">
    <div class="tcp-wrap">
      <div class="tcp-where">
        <div>
          <p class="tcp-label">§ 05 / Where it works</p>
          <h2>Anywhere guests are <em>about to step into the sun.</em></h2>
          <p class="tcp-lede">They try it on the display, pay and walk out the door. The first step into the sun does the rest, and everyone they pass sees it happen.</p>
          <div class="tcp-venues">
            <span>Hotel &amp; resort boutiques</span><span>Airport retail &amp; duty free</span><span>Theme parks &amp; attractions</span>
            <span>Beach clubs</span><span>Cruise terminals</span><span>Tour &amp; excursion desks</span><span>Water parks</span><span>Museum shops</span>
          </div>
        </div>
        <figure class="tcp-film">
          {%- assign tcp_walk = section.settings.walk_video.sources | where: 'mime_type', 'video/mp4' | first -%}
          {%- if tcp_walk -%}
            <video autoplay muted loop playsinline preload="metadata" poster="{{ 'tc-hero-shade.jpg' | asset_url }}" src="{{ tcp_walk.url }}" aria-label="A guest walks out of a boutique into the sun and his Truecolors tee colours up"></video>
          {%- else -%}
            {%- comment -%} Living photo: the same doorway in shade and in sun; the sunlight climbs the shirt and fades, on a loop. {%- endcomment -%}
            <img src="{{ 'tc-hero-shade.jpg' | asset_url }}" alt="A guest walks out of a boutique wearing the Fuhgeddaboudit tee; behind him the Truecolors Tower display" width="720" height="1280">
            <img class="tcp-film-sun" src="{{ 'tc-hero-sun.jpg' | asset_url }}" alt="" aria-hidden="true" width="720" height="1280">
          {%- endif -%}
          <figcaption>Shade inside · sun outside</figcaption>
        </figure>
      </div>

      <div class="tcp-faq">
        <details><summary>What do we earn?</summary><p>A set share of every shirt sold, agreed up front. The retail price is the same at every location, so guests see one price everywhere. We settle every 15 days, and weekly once a location sells enough.</p></details>
        <details><summary>Who takes the payment?</summary><p>Either works. We can put our own card terminal at the display, so you handle no cash or reconciliation and we pay you your share. Or you sell through your own till and pay us our share at each settlement.</p></details>
        <details><summary>Who owns the stock?</summary><p>We do, until it sells. Shirts are supplied on consignment, so there's no purchase order and nothing to write off. At the end of the agreement we collect the display and any unsold stock.</p></details>
        <details><summary>Is the UV light safe for guests?</summary><p>Yes. The light is UV-A, sealed inside the display behind UV-filtering acrylic, so what reaches the guest is visible light and the colour change. It runs for 20 seconds per press and switches off if the service door is opened.</p></details>
        <details><summary>Can we have designs for our property?</summary><p>Yes. Our team draws designs around your city, resort or landmark, and you approve them before printing. We can also start you on catalogue designs while your own are in production.</p></details>
        <details><summary>What do the floor displays need?</summary><p>A level floor and one standard power socket within 3 metres. The Prism needs about 60 × 60 cm of floor, and the Tower about 1 × 0.6 m. In airports and other busy areas we can fix the base to the floor.</p></details>
        <details><summary>What if it doesn't sell?</summary><p>Then it costs you nothing. We review sales with you after the first period. We may swap designs or move the display, and either of us can end the trial.</p></details>
      </div>
    </div>
  </section>

  <section class="tcp-band tcp-band--tint" id="tcp-enquire">
    <div class="tcp-wrap tcp-form-grid">
      <div>
        <p class="tcp-label">§ 06 / Request a display</p>
        <h2>Tell us about <em>your space.</em></h2>
        <p class="tcp-lede">Send the basics and our wholesale team will come back with display options, suggested designs and the commercial terms for your location.</p>
      </div>
      <div>
        {%- form 'contact', class: 'tcp-form', id: 'tcp-form' -%}
          {%- if form.posted_successfully? -%}
            <p class="tcp-note full">Thanks, we have your details. Our wholesale team will be in touch within two working days.</p>
          {%- elsif form.errors -%}
            <p class="tcp-note tcp-note--bad full">{{ form.errors | default_errors }}</p>
          {%- endif -%}
          <input type="hidden" name="contact[Enquiry]" value="Retail partner display">
          <label>Name<input name="contact[name]" autocomplete="name" required></label>
          <label>Business<input name="contact[Business]" autocomplete="organization" required></label>
          <label>Email<input type="email" name="contact[email]" autocomplete="email" required></label>
          <label>Phone / WhatsApp<input type="tel" name="contact[phone]" autocomplete="tel"></label>
          <label>Venue type
            <select name="contact[Venue type]">
              <option>Hotel or resort boutique</option><option>Airport retail</option><option>Attraction or theme park</option>
              <option>Beach club</option><option>Gift or souvenir shop</option><option>Other</option>
            </select>
          </label>
          <label>City<input name="contact[City]" autocomplete="address-level2"></label>
          <div class="full">
            <label style="margin-bottom:10px">Displays you're interested in</label>
            <div class="tcp-choice">
              <label><input type="checkbox" name="contact[Sunbox]" value="Yes"> Sunbox · countertop</label>
              <label><input type="checkbox" name="contact[Prism]" value="Yes"> Prism · 3-sided</label>
              <label><input type="checkbox" name="contact[Tower]" value="Yes"> Tower · stock unit</label>
              <label><input type="checkbox" name="contact[Not sure]" value="Yes"> Not sure yet</label>
            </div>
          </div>
          <label class="full">Number of outlets<input name="contact[Outlets]" inputmode="numeric" placeholder="e.g. 3"></label>
          <label class="full">About the space (optional)<textarea name="contact[body]" placeholder="Where would it go? Footfall, size of the spot, anything we should know."></textarea></label>
          <div class="full"><button class="tcp-btn" type="submit">Request a display →</button></div>
        {%- endform -%}
      </div>
    </div>
  </section>

</div>

<script>
  (function () {
    // Opens in the shade; the sun sweeps in once the photo is on screen. The button switches back and forth.
    var box = document.getElementById('tcp-reveal');
    if (!box) return;
    var btn = box.querySelector('.tcp-reveal-btn');
    function set(on) {
      box.classList.toggle('on', on);
      btn.setAttribute('aria-pressed', String(on));
      btn.textContent = on ? '☁ Back to the shade' : '☀ Step into the sun';
    }
    btn.addEventListener('click', function () { set(!box.classList.contains('on')); });
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return set(true);
    var io = new IntersectionObserver(function (es) {
      if (es[0].isIntersecting) { io.disconnect(); setTimeout(function () { set(true); }, 900); }
    }, { threshold: 0.5 });
    io.observe(box);
  })();

  (function () {
    // Press-for-sun clips: play from the start on hover or tap; on touch screens, once as the card scrolls into view.
    var touch = matchMedia('(hover: none)').matches;
    document.querySelectorAll('.tcp-unit').forEach(function (card) {
      var v = card.querySelector('.tcp-clip');
      if (!v) return;
      var hide, pinned = false;
      function play() { clearTimeout(hide); card.classList.add('playing'); v.currentTime = 0; v.play().catch(function () {}); }
      function stop() { pinned = false; card.classList.remove('playing'); v.pause(); }
      v.addEventListener('ended', function () { hide = setTimeout(stop, 1500); });
      // A click plays the clip through; a hover plays only while the pointer stays on the card.
      card.querySelector('.tcp-clip-hint').addEventListener('click', function () { pinned = true; play(); });
      if (!touch) {
        card.addEventListener('mouseenter', function () { if (!pinned) play(); });
        card.addEventListener('mouseleave', function () { if (!pinned) stop(); });
        return;
      }
      var io = new IntersectionObserver(function (es) { if (es[0].isIntersecting) { io.disconnect(); play(); } }, { threshold: 0.6 });
      io.observe(card);
    });
  })();
</script>

{% schema %}
{
  "name": "Retail partners",
  "tag": "section",
  "class": "tcp-section",
  "settings": [
    { "type": "video", "id": "walk_video", "label": "Walk-out video (§05)", "info": "walk-video.mp4. Without it §05 shows the shade-to-sun photo loop." },
    { "type": "video", "id": "screen_video", "label": "Prism screen loop (3D viewer)", "info": "screen-video.mp4. Without it the 3D screen draws its own sweep." },
    { "type": "video", "id": "sunbox_clip", "label": "Sunbox press-for-sun clip", "info": "sunbox-clip.mp4, plays over the card render." },
    { "type": "video", "id": "prism_clip", "label": "Prism press-for-sun clip", "info": "prism-clip.mp4, plays over the card render." },
    { "type": "video", "id": "tower_clip", "label": "Tower press-for-sun clip", "info": "tower-clip.mp4, plays over the card render." },
    { "type": "image_picker", "id": "sunbox_image", "label": "Sunbox render", "info": "Optional. Overrides the theme asset tc-display-sunbox.jpg (2:3 portrait)." },
    { "type": "image_picker", "id": "prism_image", "label": "Prism render", "info": "Optional. Overrides the theme asset tc-display-prism.jpg (2:3 portrait)." },
    { "type": "image_picker", "id": "tower_image", "label": "Tower render", "info": "Optional. Overrides the theme asset tc-display-tower.jpg (2:3 portrait)." }
  ],
  "presets": [{ "name": "Retail partners" }]
}
{% endschema %}
